<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension is the actual credential provider. Must match the host app. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>

	<!-- Same App Group + Keychain group as the host app so the extension reads the
	     shared vault and unwraps the shared data-encryption key. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.hitoshiichikawa.ios.keynest</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.hitoshiichikawa.ios.keynest.shared</string>
	</array>
</dict>
</plist>
